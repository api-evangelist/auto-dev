{
  "opencollection": "1.0.0",
  "info": {
    "name": "Auto.dev Dealers Market Value API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Market Value",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get vehicle specifications",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.auto.dev/specs/:vin",
            "params": [
              {
                "name": "vin",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns detailed build specifications for a vehicle by VIN, including engine, fuel, measurements, drivetrain, warranty, safety, seating, and base MSRP / invoice pricing."
        }
      ]
    }
  ],
  "bundled": true
}