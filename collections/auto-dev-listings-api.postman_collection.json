          "name": "Search vehicle listings",
          "request": {
            "name": "Search vehicle listings",
            "description": {
              "content": "Searches used-car inventory from US physical and online dealers. Supports filtering by vehicle attributes, retail listing attributes, and location, with page- and cursor-based pagination.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "listings"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "vehicle.make",
                  "value": "<string>",
                  "description": "Manufacturer name."
                },
                {
                  "disabled": false,
                  "key": "vehicle.model",
                  "value": "<string>",
                  "description": "Model name."
                },
                {
                  "disabled": false,
                  "key": "vehicle.year",
                  "value": "<string>",
                  "description": "Model year, supports ranges such as 2018-2024."
                },
                {
                  "disabled": false,
                  "key": "retailListing.price",
                  "value": "<string>",
                  "description": "Retail price, supports ranges such as 10000-30000."
                },
                {
                  "disabled": false,
                  "key": "retailListing.state",
                  "value": "<string>",
                  "description": "Two-letter state abbreviation."
                },
                {
                  "disabled": false,
                  "key": "retailListing.cpo",
                  "value": "<boolean>",
                  "description": "Certified pre-owned status."
                },
                {
                  "disabled": false,
                  "key": "zip",
                  "value": "<string>",
                  "description": "Postal code to center a proximity search."
                },
                {
                  "disabled": false,
                  "key": "distance",
                  "value": "50",
                  "description": "Search radius in miles."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Results per page; capped by plan (Starter 20, Growth 100, Scale 500)."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Opaque token for deep pagination."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "updatedAt.desc",
                  "description": "Sort field and direction, e.g. price.asc or year.desc."
                },
                {
                  "disabled": false,
                  "key": "select",
                  "value": "<string>",
                  "description": "Comma-separated field paths to project."
                }
